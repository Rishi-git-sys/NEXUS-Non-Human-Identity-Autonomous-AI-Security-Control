# Application
APP_ENV=development
APP_NAME="NEXUS"
APP_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/nexus

# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-placeholder
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-placeholder

# Redis
REDIS_URL=redis://localhost:6379

# GitHub Integration
GITHUB_CLIENT_ID=your-github-client-id-placeholder
GITHUB_CLIENT_SECRET=your-github-client-secret-placeholder

# AWS Integration (Phase 7B: Dynamic Credential Federation)
# Production Mode (Recommended): Temporary credentials via STS AssumeRole
AWS_REGION=us-east-1
AWS_ROLE_ARN=arn:aws:iam::123456789012:role/NexusSecurityAuditRole
AWS_EXTERNAL_ID=nexus-tenant-external-id
AWS_ROLE_SESSION_NAME=nexus-governance-session
AWS_SESSION_DURATION=3600

# Development Fallback Mode (Optional: Long-lived static access keys)
# Note: In production, configure AWS_ROLE_ARN instead of static keys.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# NEXUS AI Investigation Engine (Phase 8D)
OPENAI_API_KEY=
NEXUS_AI_PROVIDER=openai
NEXUS_AI_INVESTIGATION_MODEL=
NEXUS_AI_INVESTIGATION_TIMEOUT_MS=

# NEXUS NVIDIA Security Intelligence (Phase 8E - Advisory / Augmentative)
# Supports any NVIDIA NIM OpenAI-compatible model, including Nemotron:
# - nvidia/llama-3.1-nemotron-70b-instruct
NEXUS_NVIDIA_ENABLED=false
NEXUS_NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NEXUS_NVIDIA_API_KEY=
NEXUS_NVIDIA_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
NEXUS_NVIDIA_TIMEOUT_MS=30000



